#!/bin/bash

set -uo pipefail
umask 077

CONFIG="/etc/homelab-backup/backup.conf"

die() {
    echo "ERROR: $*"
    exit 1
}

if [ "$EUID" -ne 0 ]; then
    die "must run as root"
fi

if [ ! -f "$CONFIG" ]; then
    die "config not found: $CONFIG"
fi

#shellcheck source=/dev/null
source "$CONFIG"
export AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE

exec 9>/run/s3-sync.lock
flock -n 9 || die "another s3 backup is running"

rm -rf -- /tmp/s3-sync.*

WORK=$(mktemp -d /tmp/s3-sync.XXXXXX) || die "could not create work folder"
STOPPED=""

cleanup() {
    if [ -n "$STOPPED" ]; then
        echo "restarting $STOPPED"
        docker compose -f "$STOPPED/docker-compose.yaml" start
    fi
    rm -rf -- "${WORK:?}"
}

trap cleanup EXIT

upload() {
    local name="$1"
    shift
    local out="$WORK/$name.tar.zst.age"

    tar --zstd -cf - "$@" | age -R "$AGE_RECIPIENTS" -o "$out" || { echo "ERROR: failed to create archive for $name"; return 1; }
    /usr/local/bin/aws s3 cp "$out" "s3://$BUCKET/$HOST_PREFIX/$name.tar.zst.age" --only-show-errors || { echo "ERROR: failed to upload $name"; return 1; }
    rm -f -- "$out"
    echo "uploaded $HOST_PREFIX/$name"
}

backup_jellyfin() {
    local dir="$STACKS_DIR/jellyfin"
    local result=0

    STOPPED="$dir"
    docker compose -f "$dir/docker-compose.yaml" stop || result=1

    if [ "$result" -eq 0 ]; then
        upload jellyfin -C "$dir" \
            --exclude=./cache \
            --exclude=./config/metadata \
            --exclude=./config/log \
            . || result=1
    fi

    docker compose -f "$dir/docker-compose.yaml" start || result=1
    STOPPED=""
    return "$result"
}

backup_arr_stack() {
    local dir="$STACKS_DIR/arr-stack"
    local result=0

    STOPPED="$dir"
    docker compose -f "$dir/docker-compose.yaml" stop || result=1

    if [ "$result" -eq 0 ]; then
        upload arr-stack -C "$dir" \
            --exclude=./seerr/config/logs \
            --exclude=./seerr/config/cache \
            --exclude=./qbittorrent/config/.cache \
            --exclude=./qbittorrent/config/qBittorrent/BT_backup \
            --exclude=./qbittorrent/config/qBittorrent/GeoDB \
            --exclude=./qbittorrent/config/qBittorrent/logs \
            --exclude=./qbittorrent/config/qBittorrent/lockfile \
            ./docker-compose.yaml \
            ./sonarr/config/Backups \
            ./radarr/config/Backups \
            ./prowlarr/config/Backups \
            ./seerr/config \
            ./qbittorrent/config \
            || result=1
    fi

    docker compose -f "$dir/docker-compose.yaml" start || result=1
    STOPPED=""
    return "$result"
}

backup_network_stack() {
    local dir="$STACKS_DIR/network-stack"
    local zip="$WORK/pihole-teleporter.zip"
    local file

    docker exec pihole sh -c 'rm -f /tmp/*teleporter*.zip' || return 1
    docker exec -w /tmp pihole pihole-FTL --teleporter >/dev/null || return 1
    file=$(docker exec pihole sh -c 'ls /tmp/*teleporter*.zip') || return 1
    docker cp -q "pihole:$file" "$zip" || return 1
    docker exec pihole rm -f "$file"

    upload network-stack \
        -C "$dir" ./.env ./docker-compose.override.yaml \
        -C "$WORK" ./pihole-teleporter.zip \
        || { rm -f -- "$zip"; return 1; }
    rm -f -- "$zip"
}

backup_caddy() {
    upload caddy -C "$STACKS_DIR/caddy" .
}

backup_nebula_sync() {
    upload nebula-sync -C "$STACKS_DIR/nebula-sync" .
}

failed=""

for svc in $SERVICES; do
    case "$svc" in
        jellyfin)      backup_jellyfin ;;
        arr-stack)     backup_arr_stack ;;
        network-stack) backup_network_stack ;;
        caddy)         backup_caddy ;;
        nebula-sync)   backup_nebula_sync ;;
        *)             echo "ERROR: unknown service: $svc"; false ;;
    esac || failed="$failed $svc"
done

if [ -n "$failed" ]; then
    die "backup failed for:$failed"
fi

echo "all backups succeeded"